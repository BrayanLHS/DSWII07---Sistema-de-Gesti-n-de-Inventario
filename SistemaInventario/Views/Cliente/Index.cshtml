@model List<SistemaInventario.Models.ProductoViewModel>
@{
    ViewData["Title"] = "Productos (vía API)";
}

<h1>Productos consumidos desde el API</h1>
<p class="text-muted">Esta vista no consulta la base de datos directamente: llama a <code>/api/productosapi</code> usando <code>HttpClient</code>.</p>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="table-card">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Stock</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || Model.Count == 0)
        {
            <tr><td colspan="6">No se recibieron productos del API.</td></tr>
        }
        else
        {
            foreach (var p in Model)
            {
                <tr>
                    <td>@p.IdProducto</td>
                    <td>@p.Nombre</td>
                    <td>@p.NombreCategoria</td>
                    <td>S/ @p.Precio.ToString("N2")</td>
                    <td>@p.Stock</td>
                    <td><a asp-action="Detalle" asp-route-id="@p.IdProducto" class="btn btn-sm btn-outline-info">Ver</a></td>
                </tr>
            }
        }
    </tbody>
</table>
</div>
