@model List<SistemaInventario.Models.ProductoViewModel>
@{
    ViewData["Title"] = "Catálogo de productos";
    var buscar = ViewBag.Buscar as string;
    int pagina = ViewBag.Pagina ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int total = ViewBag.Total ?? 0;
    int inicio = ViewBag.Inicio ?? 0;
    int fin = ViewBag.Fin ?? 0;
    int? idCategoria = ViewBag.IdCategoria as int?;
    var nombreCategoria = ViewBag.NombreCategoria as string;
    int? idProveedor = ViewBag.IdProveedor as int?;
    var nombreProveedor = ViewBag.NombreProveedor as string;
    bool stockBajo = ViewBag.StockBajo ?? false;
    const int stockMinimo = 10;
    bool hayFiltros = !string.IsNullOrWhiteSpace(buscar) || idCategoria.HasValue || idProveedor.HasValue || stockBajo;
}

<h1>Catálogo de productos</h1>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="d-flex justify-content-end mb-3 flex-wrap" style="gap:.5rem;">
    <a asp-action="ExportarExcel" class="btn btn-outline-success">Exportar Excel</a>
    <a asp-action="ExportarPdf" class="btn btn-outline-danger">Exportar PDF</a>
    <a asp-action="Registrar" class="btn btn-primary">+ Nuevo producto</a>
</div>

<form method="get" class="d-flex flex-wrap align-items-center mb-3" style="gap:.5rem;">
    <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Buscar por nombre..." style="max-width:220px;" />
    <select name="idCategoria" class="form-select" asp-items="ViewBag.Categorias" style="max-width:220px;">
        <option value="">Todas las categorías</option>
    </select>
    <select name="idProveedor" class="form-select" asp-items="ViewBag.Proveedores" style="max-width:220px;">
        <option value="">Todos los proveedores</option>
    </select>
    <div class="form-check">
        <input type="checkbox" name="stockBajo" value="true" class="form-check-input" id="stockBajoCheck" checked="@stockBajo" />
        <label class="form-check-label" for="stockBajoCheck">Solo stock bajo</label>
    </div>
    <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    @if (hayFiltros)
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    }
</form>

@if (hayFiltros)
{
    <div class="d-flex flex-wrap align-items-center mb-3" style="gap:.4rem;">
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <a asp-action="Index" asp-route-idCategoria="@idCategoria" asp-route-idProveedor="@idProveedor" asp-route-stockBajo="@stockBajo"
               class="badge bg-secondary text-decoration-none">
                Nombre: @buscar <i class="bi bi-x-lg ms-1"></i>
            </a>
        }
        @if (idCategoria.HasValue)
        {
            <a asp-action="Index" asp-route-buscar="@buscar" asp-route-idProveedor="@idProveedor" asp-route-stockBajo="@stockBajo"
               class="badge bg-secondary text-decoration-none">
                Categoría: @nombreCategoria <i class="bi bi-x-lg ms-1"></i>
            </a>
        }
        @if (idProveedor.HasValue)
        {
            <a asp-action="Index" asp-route-buscar="@buscar" asp-route-idCategoria="@idCategoria" asp-route-stockBajo="@stockBajo"
               class="badge bg-secondary text-decoration-none">
                Proveedor: @nombreProveedor <i class="bi bi-x-lg ms-1"></i>
            </a>
        }
        @if (stockBajo)
        {
            <a asp-action="Index" asp-route-buscar="@buscar" asp-route-idCategoria="@idCategoria" asp-route-idProveedor="@idProveedor"
               class="badge bg-danger text-decoration-none">
                Solo stock bajo <i class="bi bi-x-lg ms-1"></i>
            </a>
        }
    </div>
}

<p class="text-muted small">
    @if (total == 0)
    {
        <text>No hay productos que coincidan.</text>
    }
    else
    {
        <text>Mostrando @inicio-@fin de @total producto@(total == 1 ? "" : "s")</text>
    }
</p>

<div class="table-card">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Proveedor</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || Model.Count == 0)
        {
            <tr><td colspan="7">No hay productos registrados.</td></tr>
        }
        else
        {
            foreach (var p in Model)
            {
                <tr class="@(p.Stock < stockMinimo ? "table-danger" : "")">
                    <td>@p.IdProducto</td>
                    <td>@p.Nombre</td>
                    <td>@p.NombreCategoria</td>
                    <td>@(p.NombreProveedor ?? "-")</td>
                    <td>S/ @p.Precio.ToString("N2")</td>
                    <td>
                        @p.Stock
                        @if (p.Stock < stockMinimo)
                        {
                            <span class="badge bg-danger">Bajo</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <div class="d-flex flex-wrap" style="gap:.4rem;">
                            <a asp-action="Detalle" asp-route-id="@p.IdProducto" class="btn btn-sm btn-outline-info">Ver</a>
                            <a asp-action="Editar" asp-route-id="@p.IdProducto" class="btn btn-sm btn-outline-warning">Editar</a>
                            <a asp-controller="Movimiento" asp-action="Index" asp-route-idProducto="@p.IdProducto" class="btn btn-sm btn-outline-secondary">Kardex</a>
                            <form asp-action="Eliminar" asp-route-id="@p.IdProducto" method="post" class="d-inline" data-confirm="¿Eliminar este producto?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

@if (!hayFiltros && totalPaginas > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == pagina ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
